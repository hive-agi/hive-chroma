{:paths ["src" "resources"]
 ;; hive-chroma: the Chroma vector-database backend, mounted into a host as an
 ;; IAddon. It depends on hive-spi and never on hive-mcp, in any scope: every
 ;; host service arrives through hive-spi.vector.host-services, which the host
 ;; publishes and hive-chroma.host calls through.
 :deps {org.clojure/clojure    {:mvn/version "1.12.6"}
        org.clojure/data.json  {:mvn/version "2.5.1"}
        com.taoensso/timbre    {:mvn/version "6.8.0"}
        metosin/malli          {:mvn/version "0.20.2"}

        ;; Raw Chroma HTTP client (BuddhiLW fork with v2 API support).
        ;; hive-chroma.client resolves it lazily, so a build without it loads
        ;; and fails at the first vendor call with a reason.
        io.github.buddhilw/clojure-chroma-client
        {:git/tag "v0.1.0-hive" :git/sha "e575d5a"}

        ;; IMemoryStore port family, memory/lifecycle registries, the
        ;; embedding-space value layer and the backend host-services registry.
        io.github.hive-agi/hive-spi   {:mvn/version "1.4.18"}
        ;; IAddon contract.
        io.github.hive-agi/hive-addon {:mvn/version "1.1.13"}
        ;; Result DSL, read/write gates, bounded derefs.
        io.github.hive-agi/hive-dsl   {:mvn/version "0.6.2"}
        io.github.hive-agi/hive-weave {:mvn/version "0.4.7"}}

 :aliases
 {:dev  {:extra-paths ["dev" "test"]
         :extra-deps {nrepl/nrepl {:mvn/version "1.8.0"}
                      cider/cider-nrepl {:mvn/version "0.62.2"}
                      io.github.hive-agi/hive-test {:mvn/version "0.5.2"}
                      io.github.hive-agi/hive-schemas {:mvn/version "0.2.2"}
                      org.clojure/test.check {:mvn/version "1.1.3"}
                      io.github.hive-agi/hive-help {:mvn/version "0.2.1"}}}
  ;; The suite drives the adapter through the in-memory IChromaTransport stub
  ;; (test/hive_chroma/stub/transport.clj) and a stub host published through
  ;; hive-spi (test/hive_chroma/test/host.clj). No hive-mcp on any classpath.
  ;; The :integration selector (a live Chroma server) is excluded.
  :test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}
                      org.clojure/test.check {:mvn/version "1.1.3"}
                      io.github.hive-agi/hive-test {:mvn/version "0.5.2"}
                      io.github.hive-agi/hive-schemas {:mvn/version "0.2.2"}
                      io.github.hive-agi/hive-help {:mvn/version "0.2.1"}}
         :jvm-opts ["-Xmx2g"]
         :main-opts ["-m" "cognitect.test-runner" "-d" "test" "-e" ":integration"]}

  ;; Live server suite: CHROMA_HOST/CHROMA_PORT pointing at a running Chroma.
  :test-e2e {:extra-paths ["test" "test-e2e"]
             :extra-deps {io.github.cognitect-labs/test-runner
                          {:git/tag "v0.5.1" :git/sha "dfb30dd"}
                          io.github.hive-agi/hive-test {:mvn/version "0.5.2"}
                              io.github.hive-agi/hive-help {:mvn/version "0.2.1"}}
             :main-opts ["-m" "cognitect.test-runner" "-d" "test-e2e"]}

  ;; Clojars publishing. `clojure -T:build <jar|install|deploy>`.
  :build {:deps {io.github.hive-agi/hive-build {:mvn/version "0.3.1"}}
          :ns-default hive-build.api}}}
